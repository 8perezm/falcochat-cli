# API Key - Get from your preferred provider
# OpenRouter: https://openrouter.ai/keys
# OpenAI: https://platform.openai.com/api-keys
# Together AI: https://api.together.xyz/settings/api-keys
OPENAI_API_KEY=your_api_key_here

# Optional: API URL for your provider (OpenAI API-compatible endpoints)
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI: https://api.openai.com/v1
# Together AI: https://api.together.xyz/v1
# Local Ollama: http://localhost:11434/v1
OPENAI_API_URL=https://openrouter.ai/api/v1

# Optional: Default model (provider-specific)
# OpenRouter: openai/gpt-3.5-turbo, anthropic/claude-3-haiku
# OpenAI: gpt-3.5-turbo, gpt-4
# Together AI: meta-llama/Llama-3-8b-chat-hf
# Ollama: llama3, mistral
OPENAI_MODEL=openai/gpt-3.5-turbo

# Optional: Language preference (e.g., en, es, fr, de, zh, ja)
# Only add this if you want responses in a specific language
# OPENAI_LANGUAGE=es

